---
import { site } from '../config'

const path = Astro.url.pathname
const isActive = (href: string): boolean =>
  href === '/' ? path === '/' : path.startsWith(href)
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">{site.title.slice(0, 2)}</span>
      <span class="brand__name">{site.title}</span>
      <span class="brand__role">{site.role}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        site.nav.map((item) => (
          <a
            class="nav__link"
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="theme-switch" role="group" aria-label="颜色主题">
      <button
        class="theme-switch__btn"
        type="button"
        data-theme-set="light"
        aria-pressed="false"
        aria-label="浅色主题"
        title="浅色"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
          <circle cx="8" cy="8" r="3.1" />
          <path d="M8 1.2v1.5M8 13.3v1.5M1.2 8h1.5M13.3 8h1.5M3.2 3.2l1.06 1.06M11.74 11.74l1.06 1.06M12.8 3.2l-1.06 1.06M4.26 11.74l-1.06 1.06" />
        </svg>
      </button>
      <button
        class="theme-switch__btn"
        type="button"
        data-theme-set="dark"
        aria-pressed="false"
        aria-label="深色主题"
        title="深色"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
          <path d="M13.4 9.9A5.9 5.9 0 0 1 6.1 2.6a5.9 5.9 0 1 0 7.3 7.3Z" />
        </svg>
      </button>
      <button
        class="theme-switch__btn"
        type="button"
        data-theme-set="system"
        aria-pressed="false"
        aria-label="跟随系统主题"
        title="跟随系统"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <circle cx="8" cy="8" r="5.7" />
          <path d="M8 2.3a5.7 5.7 0 0 1 0 11.4Z" fill="currentColor" stroke="none" />
        </svg>
      </button>
    </div>
  </div>
</header>
