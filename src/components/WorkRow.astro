---
import type { Project } from '../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
const Tag = project.href ? 'a' : 'div'
---

<li>
  <Tag
    class="row row--work"
    {...(project.href ? { href: project.href, rel: 'noopener', target: '_blank' } : {})}
  >
    <span class="row__title">{project.title}</span>
    <span class="row__meta">{project.year}</span>
  </Tag>
</li>
