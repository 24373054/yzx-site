---
import type { Project } from '../data/projects'

interface Props {
  project: Project
  index: number
}

const { project, index } = Astro.props
const ordinal = String(index + 1).padStart(2, '0')
const Tag = project.href ? 'a' : 'div'
---

<li>
  <Tag
    class="row row--work"
    {...(project.href ? { href: project.href, rel: 'noopener', target: '_blank' } : {})}
  >
    <span class="row__index">{ordinal}</span>
    <div>
      <div class="row__head">
        <h3 class="row__title">{project.title}</h3>
        <span class="row__year">{project.year}</span>
        {project.status && <span class="chip chip--status">{project.status}</span>}
      </div>
      <p class="row__summary">{project.summary}</p>
      <ul class="chips row__tags">
        {project.tags.map((tag) => <li class="chip">{tag}</li>)}
        <li class="chip">{project.role}</li>
      </ul>
    </div>
    <span class="row__arrow" aria-hidden="true">{project.href ? '↗' : ''}</span>
  </Tag>
</li>
