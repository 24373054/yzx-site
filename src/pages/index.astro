---
import Base from '../layouts/Base.astro'
import { site } from '../config'
---

<Base>
  <h1 class="visually-hidden">{site.title}</h1>

  <!--
    The whole first screen is one generative artwork. It sits in the page, not
    in a card: the strokes fade out at every edge, the header floats on top of
    it, and the field runs from the very top of the viewport down into the page
    background. The layers below exist so the art is never a white rectangle for
    a moment: a blurred echo of the same frame (a 1 KB data URI) shows instantly,
    the live canvas fades in over it, and the sharp still only appears for
    reduced-motion or no-JS visitors.
  -->
  <section class="stage" data-ascii-field>
    <div class="stage__echo" aria-hidden="true"></div>
    <div class="stage__still" aria-hidden="true"></div>
    <canvas class="stage__canvas" aria-hidden="true"></canvas>
  </section>
</Base>

<script>
  import { mountAsciiField } from '../scripts/ascii-field'

  const host = document.querySelector<HTMLElement>('[data-ascii-field]')
  const canvas = host?.querySelector<HTMLCanvasElement>('canvas')
  if (host && canvas) mountAsciiField(host, canvas, {
    // Rendering the fallback still: paint exactly the frame the animation starts
    // on, so the image swap is invisible.
    frozen: new URLSearchParams(location.search).has('still'),
  })
</script>
