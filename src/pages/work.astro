---
import Base from '../layouts/Base.astro'
import WorkRow from '../components/WorkRow.astro'
import { projects } from '../data/projects'

const ordered = [...projects].sort((a, b) => Number(b.year) - Number(a.year))
---

<Base title="作品" description="YZX 的作品：界面系统、文档工具与 AI 工作台。">
  <section class="shell page">
    <h1 class="visually-hidden">作品</h1>
    <ul class="rows">
      {ordered.map((project) => <WorkRow project={project} />)}
    </ul>
  </section>
</Base>
