---
import Base from '../layouts/Base.astro'
import { site } from '../config'
---

<Base title="关于" description="YZX — 独立开发者，做网站与界面系统。">
  <section class="shell page about">
    <h1 class="visually-hidden">关于</h1>

    <div class="about__body">
      {site.about.map((line) => <p>{line}</p>)}
    </div>

    <p class="about__links">
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      {
        site.socials.map((item) => (
          <>
            <span class="about__dot" aria-hidden="true">
              ·
            </span>
            <a class="link" href={item.href} rel="me noopener" target="_blank">
              {item.label}
            </a>
          </>
        ))
      }
    </p>
  </section>
</Base>
